# Copy to .env and fill in values:
#   cp .env.example .env

# --- OpenAI (default LLM provider) ---
OPENAI_API_KEY=sk-your-openai-api-key

# Optional: pace OpenAI calls to your org TPM (recommended on tier-1 accounts)
OPENAI_TPM_LIMIT=30000
LLM_TOKEN_ESTIMATE=3000
LLM_MAX_RETRIES=5

# LLM backend: openai (default) — bedrock deferred until provider ships
# LLM_PROVIDER=openai

# --- Slack MCP OAuth ---
SLACK_CLIENT_ID=your-slack-app-client-id
SLACK_CLIENT_SECRET=your-slack-app-client-secret

# --- AWS Bedrock (npm run bedrock:ask) ---
AWS_PROFILE=DeveloperPlus-ACCOUNT_ID
AWS_REGION=us-east-1
BEDROCK_MODEL=sonnet-4.6
# BEDROCK_MODEL_ID=arn:...   # optional — overrides BEDROCK_MODEL / bedrock.json
# BEDROCK_MAX_TOKENS=1024
