    "sonnet-5": { "provider": "bedrock", "modelId": "sonnet-5" },
    "haiku-4.5": { "provider": "bedrock", "modelId": "haiku-4.5" },
    "opus-4.6": { "provider": "bedrock", "modelId": "opus-4.6" },
    "opus-4.8": { "provider": "bedrock", "modelId": "opus-4.8" }
